NEXT_PUBLIC_SITE_URL=https://reupmatic.canhta.com

# Facebook token broker (owner prerequisite). Set both in Vercel; the route refuses to run without
# them. META_GRAPH_BASE_URL exists only so tests can point at a local fake Graph endpoint.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_BASE_URL=https://graph.facebook.com

# Optional download overrides. Leave both unset to serve the current asset from the
# canhta/reupmatic GitHub release via the /download/mac and /download/win redirects.
# NEXT_PUBLIC_MAC_DOWNLOAD_URL=
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=
