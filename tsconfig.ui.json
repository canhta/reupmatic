{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "app/ui/**/*",
    "app/core/subtitles/cues.ts"
  ]
}
