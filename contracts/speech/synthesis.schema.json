{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reupmatic:synthesis:1",
  "title": "Local spoken-text synthesis and verified natural-audio artifacts",
  "$comment": "Runtime additionally checks UTF-16 units, nonblank words, ordered unique cue IDs, end > start, no lone surrogates, 20000 text UTF-8 bytes, 63000 parameter / 64000 envelope JSON bytes. Exact input correlation; one segment per requested cue in order, each cue's audio span under 60 s with the measured leading silence it was given, total at most 600 s. The result reports the sample rate it produced, which must be one this build supports; WAV is canonical mono PCM16 at that reported rate. Hashes, confined native files and matching receipts must be independently verified. This contract does not imply linguistic completeness or source-time alignment. Language is a declaration for the SDK bilingual normalizer, not an accent lock.",
  "$defs": {
    "worker_params": {
      "type": "object",
      "properties": {
        "source_layer": {
          "const": "spoken"
        },
        "source_token": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "language": {
          "enum": ["en", "vi"]
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "voice_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\u0000]+$"
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              },
              "end_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400000
              }
            },
            "required": ["id", "text", "start_ms", "end_ms"],
            "additionalProperties": false
          }
        }
      },
      "required": ["source_layer", "source_token", "language", "model_id", "voice_id", "cues"],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "params": {
          "type": "object",
          "properties": {
            "source_layer": {
              "const": "spoken"
            },
            "source_token": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,128}$"
            },
            "language": {
              "enum": ["en", "vi"]
            },
            "model_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "voice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000]+$"
            },
            "cues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "start_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400000
                  },
                  "end_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                  }
                },
                "required": ["id", "text", "start_ms", "end_ms"],
                "additionalProperties": false
              }
            }
          },
          "required": ["source_layer", "source_token", "language", "model_id", "voice_id", "cues"],
          "additionalProperties": false
        }
      },
      "required": ["request_id", "revision", "params"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "source_layer": {
          "const": "spoken"
        },
        "source_token": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "language": {
          "enum": ["en", "vi"]
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "voice_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\u0000]+$"
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              },
              "end_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400000
              }
            },
            "required": ["id", "text", "start_ms", "end_ms"],
            "additionalProperties": false
          }
        },
        "kind": {
          "const": "synthesis"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sample_rate": {
          "enum": [16000, 22050, 24000, 32000, 44100, 48000]
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28800000
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "cue_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000]+$"
              },
              "start_frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 28799999
              },
              "end_frame": {
                "type": "integer",
                "minimum": 1,
                "maximum": 28800000
              },
              "lead_silence_frames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 28800000
              }
            },
            "required": ["cue_id", "start_frame", "end_frame", "lead_silence_frames"],
            "additionalProperties": false
          }
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "source_layer",
        "source_token",
        "language",
        "model_id",
        "voice_id",
        "cues",
        "kind",
        "artifact_id",
        "sha256",
        "sample_rate",
        "frames",
        "duration_ms",
        "segments",
        "runtime"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Z_]{1,80}$"
            }
          ]
        },
        "model_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "engine": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          ]
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": ["en", "vi"]
          }
        },
        "voices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[^\\u0000]+$"
              }
            },
            "required": ["id", "label"],
            "additionalProperties": false
          }
        },
        "verified": {
          "const": false
        }
      },
      "required": ["available", "code", "model_id", "engine", "languages", "voices", "verified"],
      "additionalProperties": false
    }
  }
}
