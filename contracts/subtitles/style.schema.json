{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reupmatic:subtitle-style:1",
  "title": "Complete global or cue appearance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "font_family",
    "font_size_pct",
    "outline_pct",
    "shadow_pct",
    "box_opacity",
    "margin_x_pct",
    "margin_y_pct",
    "spacing_pct",
    "text_color",
    "outline_color",
    "box_color",
    "position",
    "bold",
    "italic"
  ],
  "properties": {
    "font_family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^,\\r\\n{}\\\\\\u0000]+$"
    },
    "font_size_pct": {
      "type": "number",
      "minimum": 1,
      "maximum": 15
    },
    "outline_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "shadow_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "box_opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "margin_x_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 40
    },
    "margin_y_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 40
    },
    "spacing_pct": {
      "type": "number",
      "minimum": -0.2,
      "maximum": 2
    },
    "text_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "outline_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "box_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "position": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "bold": {
      "type": "boolean"
    },
    "italic": {
      "type": "boolean"
    }
  },
  "$comment": "Runtime requires an installed-font name made of letters, numbers, space, underscore, period or hyphen. Dimensions use output-frame percentages; box opacity > 0 selects ASS opaque-box rendering."
}
