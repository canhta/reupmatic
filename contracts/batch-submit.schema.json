{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reupmatic.invalid/contracts/batch-submit-v1",
  "title": "Reupmatic native-picker batch submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "output_id", "items"],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,128}$"
    },
    "output_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,128}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id"],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{8,128}$"
          },
          "subtitle_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{8,128}$"
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "ocr": {
          "type": "object",
          "properties": {
            "language": {
              "enum": ["en", "vi", "zh"]
            },
            "sample_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 2000
            },
            "min_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["language", "sample_ms", "min_confidence"],
          "additionalProperties": false
        },
        "inpaint": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "target": {
                  "const": "manual"
                },
                "padding_px": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "region": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["x", "y", "width", "height"],
                  "additionalProperties": false
                }
              },
              "required": ["target", "padding_px", "region"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "target": {
                  "const": "text"
                },
                "padding_px": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "language": {
                  "enum": ["en", "vi", "zh"]
                }
              },
              "required": ["target", "padding_px", "language"],
              "additionalProperties": false
            }
          ]
        },
        "editing": {
          "type": "object",
          "properties": {
            "trim": {
              "type": "object",
              "properties": {
                "start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86399999
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                }
              },
              "required": ["start_ms", "end_ms"],
              "additionalProperties": false
            },
            "crop": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              },
              "required": ["x", "y", "width", "height"],
              "additionalProperties": false
            },
            "flip": {
              "enum": ["horizontal", "vertical", "both"]
            },
            "speed": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            },
            "color": {
              "type": "object",
              "properties": {
                "brightness": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "contrast": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "saturation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "required": ["brightness", "contrast", "saturation"],
              "additionalProperties": false
            },
            "audio": {
              "type": "object",
              "properties": {
                "muted": {
                  "type": "boolean"
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 24
                }
              },
              "required": ["muted", "gain_db"],
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "aspect": {
                  "enum": ["source", "9:16", "16:9", "1:1", "4:5"]
                },
                "fit": {
                  "enum": ["contain", "cover"]
                },
                "height": {
                  "enum": [0, 480, 720, 1080, 1920]
                }
              },
              "required": ["aspect", "fit", "height"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "subtitle_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size_pct",
            "outline_pct",
            "shadow_pct",
            "box_opacity",
            "margin_x_pct",
            "margin_y_pct",
            "spacing_pct",
            "text_color",
            "outline_color",
            "box_color",
            "position",
            "bold",
            "italic"
          ],
          "properties": {
            "font_family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^,\\r\\n{}\\\\\\u0000]+$"
            },
            "font_size_pct": {
              "type": "number",
              "minimum": 1,
              "maximum": 15
            },
            "outline_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "shadow_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "box_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "margin_x_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "margin_y_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "spacing_pct": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 2
            },
            "text_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "box_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "position": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            }
          }
        }
      },
      "required": ["version"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["ocr"]
        },
        {
          "required": ["inpaint"]
        },
        {
          "required": ["editing"]
        },
        {
          "required": ["subtitle_style"]
        }
      ]
    }
  },
  "$comment": "Embedded shapes generated by scripts/sync-contracts.py; edit the canonical business schemas, then regenerate."
}
